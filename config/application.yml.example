# ============================================================
# ba-sync 部署配置 (全量) —— 在部署机上复制为 config/application.yml 并填入真实值:
#
#   cp config/application.yml.example config/application.yml
#   chmod 600 config/application.yml      # 含数据库密码, 仅部署用户可读
#
# 本文件列出 ba-sync 的全部配置项, 与 jar 内打包的 application.yml 一一对应。
# start.sh 启动时本文件逐项覆盖 jar 内配置; 因每一项都显式写出, jar 内默认值不再起作用。
# 改完 ./start.sh restart 即可, 无需重新打包。
# 真实的 config/application.yml 已被 .gitignore 忽略, 密钥只留在部署机上。
#
# 注意: 代码升级若新增配置项, 本文件未写的新项会沿用 jar 内默认值, 升级时请对照
# src/main/resources/application.yml 补齐。
# ============================================================

server:
  port: 8081                 # 健康检查: curl http://127.0.0.1:8081/api/health

spring:
  datasource:
    # 部署机与 MySQL 同机时 <DB_HOST> 填 127.0.0.1。
    # rewriteBatchedStatements=true 必须保留: 否则 JDBC 批量 upsert 退化为逐行往返。
    url: jdbc:mysql://<DB_HOST>:3306/ba?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true
    username: root
    # 二选一: 直接填明文(本文件已 chmod 600), 或写 ${DB_PASSWORD} 并在启动前 export DB_PASSWORD=...
    # (start.sh 不会自动加载 .env)
    password: <YOUR_DB_PASSWORD>
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2

binance:
  base-url: https://fapi.binance.com

  # 部署机直连币安, 必须 false。(jar 内默认 true, 供本地开发走 127.0.0.1:7897 代理)
  # 若部署机确需代理, 改为 true 并填写 host/port。
  proxy:
    enabled: false
    host: 127.0.0.1
    port: 7897

  # 请求并发与限流。频繁出现 429/418 限流日志时调低 max-requests 或调高 request-interval-ms。
  concurrency:
    max-requests: 10            # 同时在途的币安请求数 (1-50)
    request-interval-ms: 100    # 批量任务中相邻 symbol 请求的错开间隔
    history-buffer-days: 30
    task-timeout-seconds: 120   # 单个 symbol 任务超时
    weight-soft-limit: 2000     # X-MBX-USED-WEIGHT-1M 达此值全局主动退避 (币安上限 2400/min)

  # 启动数据完整性校验: 系统就绪后逐 symbol 比对记录数, 缺则补齐。
  # 首次部署会补近 30 天 日K/1h/4h K线、日线/1h OI、资金费率, 500+ 币需数分钟到十几分钟;
  # 之后每次重启只补缺口。
  init:
    enabled: true
    daily:
      days: 30
      tolerance-days: 2         # 记录数 >= days-tolerance 视为完整

  # 合约列表落盘位置 (相对 start.sh 所在目录)
  symbol:
    file-path: ./data/symbols.json

  # 多空比采集 (4 端点: 全市场账户/顶级账户/顶级持仓/Taker 比率)
  lsr:
    enabled: true
    period: 1h
    limit: 30

  # 定时任务 cron (JVM 固定 Asia/Shanghai, 均为北京时间)
  schedule:
    symbol-update: "0 0 6 * * ?"            # 合约列表
    short-term-sync: "0 */3 * * * ?"        # 1d/1h K线(含当前根) + 24h行情 + 标记价/溢价
    four-hour-kline-sync: "0 1/15 * * * ?"  # 4h K线
    funding-rate-sync: "0 5 * * * ?"        # 资金费率 (8h 结算)
    mid-freq-sync: "0 */30 * * * ?"         # 1h OI + 多空比
    daily-oi-sync: "0 10 8 * * ?"           # 日线 OI (UTC 零点后, 累积长历史)
